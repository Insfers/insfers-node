{
  "name": "@insfers/sdk",
  "version": "1.0.0",
  "description": "Official Node.js & TypeScript SDK for Insfers",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/ai.d.ts",
        "default": "./dist/ai.mjs"
      },
      "require": {
        "types": "./dist/ai.d.ts",
        "default": "./dist/ai.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "insfers",
    "payments",
    "usdc",
    "circle",
    "b2b",
    "x402",
    "agentic-commerce",
    "crypto-payments",
    "invoicing",
    "payouts",
    "payment-links"
  ],
  "author": "Insfers Inc. <support@Insfers.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Insfers/insfers-node.git"
  },
  "bugs": {
    "url": "https://github.com/Insfers/insfers-node/issues"
  },
  "homepage": "https://insfers.com",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}